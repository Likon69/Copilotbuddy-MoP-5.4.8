<mah:MetroWindow
	x:Class="CopilotBuddy.DevToolsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:honorbuddy="clr-namespace:CopilotBuddy"
	mc:Ignorable="d"
	x:Name="Window"
	Title="Developer Tools"
	Width="711"
	MinWidth="711"
	Height="480"
	MinHeight="480"
	Background="{DynamicResource WindowBackgroundBrush}"
	GlowBrush="{DynamicResource MahApps.Brushes.Accent}"
	TitleCharacterCasing="Normal"
	Icon="pack://application:,,,/images/bender.ico">
	<Grid x:Name="LayoutRoot">
		<TabControl x:Name="tabControl" Margin="0" SelectionChanged="TabControl_OnSelectionChanged">
			<TabItem x:Name="tabProfiles" Header="Profiles">
				<Grid>
					<GroupBox x:Name="groupBox" Header="Local Player Info" HorizontalAlignment="Left" Margin="8,8,0,0" VerticalAlignment="Top" Height="62.96" Width="333" Foreground="#FFFFFFFF">
						<Grid>
							<TextBlock x:Name="textBlock" HorizontalAlignment="Left" TextWrapping="Wrap" Text="Position:" Foreground="#FFFFFFFF" Margin="8,8,0,0" VerticalAlignment="Top" />
							<TextBlock x:Name="tbLocalPlayerLocation" Margin="57,8,0,0" TextWrapping="Wrap" Text="&lt;0, 0, 0&gt;" VerticalAlignment="Top" Foreground="#FFFFFFFF" HorizontalAlignment="Left" ToolTip="Double Click to Copy" Width="233" MouseDown="tbLocalPlayerLocation_MouseDown" />
							<Button x:Name="btnRefreshPosition" Height="18" HorizontalAlignment="Right" Margin="0,0,8,8" ToolTip="Refresh your position" VerticalAlignment="Bottom" Width="18" Click="btnRefreshPosition_Click">
								<Image Margin="2" Source="images/refresh.png" Stretch="UniformToFill" />
							</Button>
						</Grid>
					</GroupBox>
					<GroupBox x:Name="groupBox_Copy" Header="Current Target Info" HorizontalAlignment="Left" Margin="8,74.96,0,0" Width="333" Foreground="#FFFFFFFF" Height="227" VerticalAlignment="Top">
						<Grid>
							<TextBlock x:Name="textBlock2" HorizontalAlignment="Left" Text="Position:" Foreground="#FFFFFFFF" Margin="8,8,0,0" VerticalAlignment="Top" />
							<TextBlock x:Name="tbCTLocation" Margin="92,8,0,0" Text="0,0,0" VerticalAlignment="Top" Foreground="#FFFFFFFF" ToolTip="Double Click to Copy" HorizontalAlignment="Left" MouseDown="HandleTextBlockDoubleClick" />
							<TextBlock x:Name="textBlock2_Copy" HorizontalAlignment="Left" Text="Name:" Foreground="#FFFFFFFF" Margin="8,27.96,0,0" VerticalAlignment="Top" />
							<TextBlock x:Name="tbCTName" Margin="92,27.96,0,0" Text="Unknown" VerticalAlignment="Top" Foreground="#FFFFFFFF" ToolTip="Double Click to Copy" HorizontalAlignment="Left" MouseDown="HandleTextBlockDoubleClick" />
							<TextBlock x:Name="textBlock2_Copy1" HorizontalAlignment="Left" Text="Entry (ID):" Foreground="#FFFFFFFF" Margin="8,47.92,0,0" VerticalAlignment="Top" />
							<TextBlock x:Name="tbCTEntry" Margin="92,47.92,0,0" Text="0" Foreground="#FFFFFFFF" ToolTip="Double Click to Copy" HorizontalAlignment="Left" Height="16" VerticalAlignment="Top" MouseDown="HandleTextBlockDoubleClick" />
							<TextBlock x:Name="textBlock2_Copy2" HorizontalAlignment="Left" Text="Faction ID:" Foreground="#FFFFFFFF" Margin="8,67.88,0,0" VerticalAlignment="Top" />
							<TextBlock x:Name="tbCTFactionId" Margin="92,67.88,0,0" Text="0" VerticalAlignment="Top" Foreground="#FFFFFFFF" ToolTip="Double Click to Copy" HorizontalAlignment="Left" MouseDown="HandleTextBlockDoubleClick" />
							<TextBlock x:Name="textBlock2_Copy3" HorizontalAlignment="Left" Text="Faction Name:" Foreground="#FFFFFFFF" Margin="8,87.84,0,0" Height="15" VerticalAlignment="Top" />
							<TextBlock x:Name="tbCTFactionName" Margin="92,87.84,0,0" Text="Unknown" Foreground="#FFFFFFFF" ToolTip="Double Click to Copy" HorizontalAlignment="Left" Height="15" VerticalAlignment="Top" MouseDown="HandleTextBlockDoubleClick" />
							<TextBlock x:Name="textBlock2_Copy4" HorizontalAlignment="Left" Text="Group ID:" Foreground="#FFFFFFFF" Margin="8,107,0,0" Height="16" VerticalAlignment="Top" />
							<TextBlock x:Name="tbCTGroup1" Margin="92,107,0,0" Text="0" Foreground="#FFFFFFFF" ToolTip="Double Click to Copy" HorizontalAlignment="Left" Height="16" VerticalAlignment="Top" MouseDown="HandleTextBlockDoubleClick" />
							<TextBlock x:Name="textBlock2_Copy5" HorizontalAlignment="Left" Text="Group ID 2:" Foreground="#FFFFFFFF" Margin="8,127,0,0" Height="16" VerticalAlignment="Top" />
							<TextBlock x:Name="tbCTGroup2" Margin="92,127,0,0" Text="0" Foreground="#FFFFFFFF" ToolTip="Double Click to Copy" HorizontalAlignment="Left" Height="16" VerticalAlignment="Top" MouseDown="HandleTextBlockDoubleClick" />
							<TextBlock x:Name="textBlock2_Copy6" HorizontalAlignment="Left" Text="Vendor Type:" Foreground="#FFFFFFFF" Margin="8,147,0,0" RenderTransformOrigin="0.485,-0.664" Height="16" VerticalAlignment="Top" />
							<TextBlock x:Name="tbCTVendorType" Margin="92,147,0,0" Text="Unknown" Foreground="#FFFFFFFF" ToolTip="Double Click to Copy" HorizontalAlignment="Left" Height="16" VerticalAlignment="Top" MouseDown="HandleTextBlockDoubleClick" />
							<Button x:Name="btnCopyCTXmlInfo" Content="Copy XML" Margin="8,0,0,8" VerticalAlignment="Bottom" HorizontalAlignment="Left" Width="75" Click="btnCopyCTXmlInfo_Click" />
							<Button x:Name="btnRefreshCTInfo" HorizontalAlignment="Right" Margin="0,0,8,8" VerticalAlignment="Bottom" Width="18" Height="18" ToolTip="Refresh current target info" Click="btnRefreshCTInfo_Click">
								<Image Source="images/refresh.png" Stretch="UniformToFill" Margin="2" />
							</Button>
						</Grid>
					</GroupBox>
					<GroupBox x:Name="groupBox2" Header="Quests" Margin="347.303,8,8,8">
						<Grid>
							<ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
								<TreeView x:Name="tvQuests">
									<TreeView.ContextMenu>
										<ContextMenu Background="{DynamicResource WindowBackgroundBrush}">
											<MenuItem x:Name="CopyXML" Header="Copy XML" Click="CopyQuestOrderXML" />
										</ContextMenu>
									</TreeView.ContextMenu>
								</TreeView>
							</ScrollViewer>
							<Button x:Name="btnRefreshQuests" HorizontalAlignment="Right" Margin="0,0,8,8" VerticalAlignment="Bottom" Width="18" Height="18" ToolTip="Refresh Quests" Click="btnRefreshQuests_Click">
								<Image Source="images/refresh.png" Stretch="UniformToFill" Margin="2" />
							</Button>
							<Button x:Name="btnCopyAllQuests" HorizontalAlignment="Right" Margin="0,0,30,8" VerticalAlignment="Bottom" Width="18" Height="18" ToolTip="Copy All Quests" Click="btnCopyAllQuests_Click">
								<Image Source="images/Copy.png" Stretch="UniformToFill" Margin="2" />
							</Button>
							<Button x:Name="btnCopyAllQuestOverrides" HorizontalAlignment="Right" Margin="0,0,53,8" VerticalAlignment="Bottom" Width="18" Height="18" ToolTip="Copy All Quest Overrides" Click="btnCopyAllQuestOverrides_Click">
								<Image Source="images/Copy.png" Stretch="UniformToFill" Margin="2" />
							</Button>
						</Grid>
					</GroupBox>
					<GroupBox x:Name="groupBox1" Header="Common" Margin="8,308,0,8" HorizontalAlignment="Left" Width="333">
						<Grid>
							<Button x:Name="btnGenerateBlackspot" Content="Generate Blackspot" VerticalAlignment="Top" Margin="8,8,0,0" HorizontalAlignment="Left" Width="117" Click="btnGenerateBlackspot_Click" />
							<Button x:Name="btnGenerateHotspot" Content="Generate Hotspot" VerticalAlignment="Top" Margin="8,32,0,0" HorizontalAlignment="Left" Width="117" Click="btnGenerateHotspot_Click" />
						</Grid>
					</GroupBox>
				</Grid>
			</TabItem>
			<TabItem x:Name="tabConsole" Header="Console" ToolTip="Test Scripts and get Information" Loaded="TabConsole_OnLoaded" PreviewKeyDown="Console_OnPreviewKeyDown">
				<Grid Margin="3">
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="*" MinHeight="100" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="*" MinHeight="100" />
					</Grid.RowDefinitions>
					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="Auto" />
							<ColumnDefinition Width="Auto" />
							<ColumnDefinition Width="Auto" />
							<ColumnDefinition Width="Auto" />
							<ColumnDefinition Width="Auto" />
						</Grid.ColumnDefinitions>
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="Auto" />
								<ColumnDefinition Width="*" />
							</Grid.ColumnDefinitions>
							<Label Content="Scripts : " HorizontalAlignment="Left" VerticalAlignment="Top" />
							<ComboBox x:Name="consoleScriptSelector" VerticalAlignment="Top" IsEditable="True" Grid.Column="1" IsSynchronizedWithCurrentItem="False" SelectedIndex="0" IsTextSearchEnabled="False" SelectionChanged="ConsoleScriptSelector_OnSelectionChanged" LostFocus="ConsoleScriptSelector_OnLostFocus" />
						</Grid>
						<Button x:Name="consoleNewScript" Content="New" HorizontalAlignment="Right" VerticalAlignment="Stretch" Width="75" Grid.Column="1" Click="ConsoleNewSnipletButton_Click" />
						<Button x:Name="consoleDeleteScript" Content="Delete" HorizontalAlignment="Right" VerticalAlignment="Stretch" Width="75" Grid.Column="2" Click="ConsoleDeleteButton_Clicked" />
						<Button x:Name="consoleRunScript" Content="Run(F5)" HorizontalAlignment="Right" Grid.Column="3" VerticalAlignment="Stretch" Width="75" Click="BtnConsoleRun_Click" />
						<Button x:Name="consoleKeybind" Content="Set keybind" HorizontalAlignment="Right" Width="125" Grid.Column="4" VerticalAlignment="Stretch" Click="ConsoleKeybind_OnClick" PreviewKeyDown="ConsoleKeybind_OnPreviewKeyDown" PreviewKeyUp="ConsoleKeybind_OnPreviewKeyUp" />
					</Grid>
					<TextBox x:Name="consoleScriptSnippet" TextWrapping="NoWrap" Text="" AcceptsReturn="True" AcceptsTab="True" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextChanged="ConsoleScriptSnippet_TextChanged" LostFocus="ConsoleScriptSnippet_OnLostFocus" />
					<GridSplitter Grid.Row="2" HorizontalAlignment="Stretch" Height="3" />
					<Grid Grid.Row="3" VerticalAlignment="Stretch">
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto" />
							<RowDefinition Height="*" />
						</Grid.RowDefinitions>
						<Label Content="Results :" HorizontalAlignment="Left" VerticalAlignment="Top" />
						<TextBox x:Name="consoleScriptResult" TextWrapping="Wrap" Text="" IsReadOnly="True" Grid.Row="1" VerticalAlignment="Stretch" VerticalScrollBarVisibility="Auto" />
					</Grid>
				</Grid>
			</TabItem>
			<TabItem x:Name="tabObjects" Header="Objects">
				<Grid>
					<TabControl>
						<TabItem Header="Game Objects">
							<Grid>
								<ListView x:Name="lvGameObjectsDump" Margin="0" AlternationCount="1" ButtonBase.Click="WoWObjectListViewColumn_OnClick">
									<ListView.ContextMenu>
										<ContextMenu Background="{DynamicResource WindowBackgroundBrush}">
											<MenuItem x:Name="CopyGameObjectInfo" Header="Copy Info" Click="CopyGameObjectInfo_OnClick" />
										</ContextMenu>
									</ListView.ContextMenu>
									<ListView.View>
										<GridView>
											<GridViewColumn Header="Entry" Width="50" DisplayMemberBinding="{Binding Entry, Mode=OneTime}" />
											<GridViewColumn Header="Name" Width="150" DisplayMemberBinding="{Binding Name, Mode=OneTime}" />
											<GridViewColumn Header="GUID" Width="150" DisplayMemberBinding="{Binding Guid, Mode=OneTime}" />
											<GridViewColumn Header="Position" Width="100" DisplayMemberBinding="{Binding Location, Mode=OneTime}" />
											<GridViewColumn Header="Distance" Width="75" DisplayMemberBinding="{Binding Distance, Mode=OneTime}" />
											<GridViewColumn Header="Type" Width="75" DisplayMemberBinding="{Binding Type, Mode=OneTime}" />
											<GridViewColumn Header="Subtype" Width="75" DisplayMemberBinding="{Binding SubType, Mode=OneTime}" />
											<GridViewColumn Header="SpellFocus" Width="75" DisplayMemberBinding="{Binding SpellFocus, Mode=OneTime}" />
											<GridViewColumn Header="LockType" Width="75" DisplayMemberBinding="{Binding LockType, Mode=OneTime}" />
										</GridView>
									</ListView.View>
								</ListView>
							</Grid>
						</TabItem>
						<TabItem Header="Units">
							<Grid>
								<ListView x:Name="lvUnitsDump" Margin="0" AlternationCount="1" ButtonBase.Click="WoWObjectListViewColumn_OnClick">
									<ListView.ContextMenu>
										<ContextMenu Background="{DynamicResource WindowBackgroundBrush}">
											<MenuItem x:Name="CopyWoWUnitInfo" Header="Copy Info" Click="CopyUnitInfo_OnClick" />
											<MenuItem x:Name="ViewAurasOnUnit" Header="View Auras" Click="ViewAurasOnUnit_OnClick" />
										</ContextMenu>
									</ListView.ContextMenu>
									<ListView.View>
										<GridView>
											<GridViewColumn Header="Entry" Width="50" DisplayMemberBinding="{Binding Entry, Mode=OneTime}" />
											<GridViewColumn Header="Name" Width="150" DisplayMemberBinding="{Binding Name, Mode=OneTime}" />
											<GridViewColumn Header="GUID" Width="150" DisplayMemberBinding="{Binding Guid, Mode=OneTime}" />
											<GridViewColumn Header="Position" Width="100" DisplayMemberBinding="{Binding Location, Mode=OneTime}" />
											<GridViewColumn Header="Faction ID" Width="75" DisplayMemberBinding="{Binding FactionId, Mode=OneTime}" />
											<GridViewColumn Header="Distance" Width="75" DisplayMemberBinding="{Binding Distance, Mode=OneTime}" />
											<GridViewColumn Header="Type" Width="75" DisplayMemberBinding="{Binding Type, Mode=OneTime}" />
										</GridView>
									</ListView.View>
								</ListView>
							</Grid>
						</TabItem>
						<TabItem Header="Bag Items">
							<Grid>
								<ListView x:Name="lvItemsDump" Margin="0" AlternationCount="1" ButtonBase.Click="WoWObjectListViewColumn_OnClick">
									<ListView.ContextMenu>
										<ContextMenu Background="{DynamicResource WindowBackgroundBrush}">
											<MenuItem x:Name="CopyWoWItemInfo" Header="Copy Info" Click="CopyItemInfo_OnClick" />
										</ContextMenu>
									</ListView.ContextMenu>
									<ListView.View>
										<GridView>
											<GridViewColumn Header="Entry" Width="50" DisplayMemberBinding="{Binding Entry, Mode=OneTime}" />
											<GridViewColumn Header="Name" Width="250" DisplayMemberBinding="{Binding Name, Mode=OneTime}" />
											<GridViewColumn Header="StackCount" Width="75" DisplayMemberBinding="{Binding StackCount, Mode=OneTime}" />
											<GridViewColumn Header="Type" Width="75" DisplayMemberBinding="{Binding Type, Mode=OneTime}" />
										</GridView>
									</ListView.View>
								</ListView>
							</Grid>
						</TabItem>
					</TabControl>
					<Button x:Name="btnRefreshObjectList" HorizontalAlignment="Right" Margin="2,2,8,8" VerticalAlignment="Top" Width="18" Height="18" ToolTip="Refresh object list" Click="btnRefreshObjectList_Click">
						<Image Source="images/refresh.png" Stretch="UniformToFill" />
					</Button>
				</Grid>
			</TabItem>
			<TabItem x:Name="tabAuras" Header="Auras">
				<Grid>
					<TabControl>
						<TabItem Header="Auras on Me">
							<Grid>
								<ListView x:Name="lvAurasOnMe" Margin="0" AlternationCount="1" ButtonBase.Click="WoWObjectListViewColumn_OnClick">
									<ListView.ContextMenu>
										<ContextMenu Background="{DynamicResource WindowBackgroundBrush}">
											<MenuItem Header="Copy Info" Click="CopyAuraInfoMe_OnClick" />
										</ContextMenu>
									</ListView.ContextMenu>
									<ListView.View>
										<GridView>
											<GridViewColumn Header="SpellId" Width="50" DisplayMemberBinding="{Binding SpellId, Mode=OneTime}" />
											<GridViewColumn Header="Name" Width="150" DisplayMemberBinding="{Binding Name, Mode=OneTime}" />
											<GridViewColumn Header="StackCount" Width="75" DisplayMemberBinding="{Binding StackCount, Mode=OneTime}" />
											<GridViewColumn Header="AuraFlags" Width="150" DisplayMemberBinding="{Binding Flags, Mode=OneTime}" />
											<GridViewColumn Header="TimeLeft" Width="150" DisplayMemberBinding="{Binding TimeLeft, Mode=OneTime}" />
											<GridViewColumn Header="Creator" Width="150" DisplayMemberBinding="{Binding Creator, Mode=OneTime}" />
											<GridViewColumn Header="CreatorGuid" Width="150" DisplayMemberBinding="{Binding CreatorGuid, Mode=OneTime}" />
										</GridView>
									</ListView.View>
								</ListView>
							</Grid>
						</TabItem>
						<TabItem Header="Auras on Current Target">
							<Grid>
								<ListView x:Name="lvAurasOnTarget" Margin="0" AlternationCount="1" ButtonBase.Click="WoWObjectListViewColumn_OnClick">
									<ListView.ContextMenu>
										<ContextMenu Background="{DynamicResource WindowBackgroundBrush}">
											<MenuItem Header="Copy Info" Click="CopyAuraInfoTarget_OnClick" />
										</ContextMenu>
									</ListView.ContextMenu>
									<ListView.View>
										<GridView>
											<GridViewColumn Header="SpellId" Width="50" DisplayMemberBinding="{Binding SpellId, Mode=OneTime}" />
											<GridViewColumn Header="Name" Width="150" DisplayMemberBinding="{Binding Name, Mode=OneTime}" />
											<GridViewColumn Header="StackCount" Width="100" DisplayMemberBinding="{Binding StackCount, Mode=OneTime}" />
											<GridViewColumn Header="AuraFlags" Width="100" DisplayMemberBinding="{Binding Flags, Mode=OneTime}" />
											<GridViewColumn Header="TimeLeft" Width="150" DisplayMemberBinding="{Binding TimeLeft, Mode=OneTime}" />
											<GridViewColumn Header="Creator" Width="150" DisplayMemberBinding="{Binding Creator, Mode=OneTime}" />
											<GridViewColumn Header="CreatorGuid" Width="150" DisplayMemberBinding="{Binding CreatorGuid, Mode=OneTime}" />
										</GridView>
									</ListView.View>
								</ListView>
							</Grid>
						</TabItem>
						<TabItem x:Name="tabAurasOnUnit" Header="Auras on Custom Target" Visibility="Collapsed">
							<Grid>
								<ListView x:Name="lvAurasOnUnit" Margin="0" AlternationCount="1" ButtonBase.Click="WoWObjectListViewColumn_OnClick">
									<ListView.ContextMenu>
										<ContextMenu Background="{DynamicResource WindowBackgroundBrush}">
											<MenuItem Header="Copy Info" Click="CopyAuraInfoUnit_OnClick" />
										</ContextMenu>
									</ListView.ContextMenu>
									<ListView.View>
										<GridView>
											<GridViewColumn Header="SpellId" Width="50" DisplayMemberBinding="{Binding SpellId, Mode=OneTime}" />
											<GridViewColumn Header="Name" Width="150" DisplayMemberBinding="{Binding Name, Mode=OneTime}" />
											<GridViewColumn Header="StackCount" Width="100" DisplayMemberBinding="{Binding StackCount, Mode=OneTime}" />
											<GridViewColumn Header="AuraFlags" Width="100" DisplayMemberBinding="{Binding Flags, Mode=OneTime}" />
											<GridViewColumn Header="TimeLeft" Width="150" DisplayMemberBinding="{Binding TimeLeft, Mode=OneTime}" />
											<GridViewColumn Header="Creator" Width="150" DisplayMemberBinding="{Binding Creator, Mode=OneTime}" />
											<GridViewColumn Header="CreatorGuid" Width="150" DisplayMemberBinding="{Binding CreatorGuid, Mode=OneTime}" />
										</GridView>
									</ListView.View>
								</ListView>
							</Grid>
						</TabItem>
					</TabControl>
					<Button x:Name="btnRefreshAuraList" HorizontalAlignment="Right" Margin="2,2,8,8" VerticalAlignment="Top" Width="18" Height="18" ToolTip="Refresh aura list" Click="BtnRefreshAuraList_OnClick">
						<Image Source="images/refresh.png" Stretch="UniformToFill" />
					</Button>
				</Grid>
			</TabItem>
			<TabItem x:Name="tabMerchantItems" Header="Merchant Items">
				<Grid>
					<ListView x:Name="lvMerchantItems" Margin="0" AlternationCount="1" ButtonBase.Click="WoWObjectListViewColumn_OnClick">
						<ListView.ContextMenu>
							<ContextMenu Background="{DynamicResource WindowBackgroundBrush}">
								<MenuItem Header="Copy Info" Click="CopyMerchantItemInfo_OnClick" />
							</ContextMenu>
						</ListView.ContextMenu>
						<ListView.View>
							<GridView>
								<GridViewColumn Header="ItemId" Width="50" DisplayMemberBinding="{Binding ItemId, Mode=OneTime}" />
								<GridViewColumn Header="Name" Width="200" DisplayMemberBinding="{Binding Name, Mode=OneTime}" />
								<GridViewColumn Header="Quantity" Width="100" DisplayMemberBinding="{Binding Quantity, Mode=OneTime}" />
								<GridViewColumn Header="BuyPrice" Width="100" DisplayMemberBinding="{Binding BuyPrice, Mode=OneTime}" />
								<GridViewColumn Header="NumAvailable" Width="100" DisplayMemberBinding="{Binding NumAvailable, Mode=OneTime}" />
							</GridView>
						</ListView.View>
					</ListView>
					<Button x:Name="btnRefreshMerchantItems" HorizontalAlignment="Right" Margin="2,2,8,8" VerticalAlignment="Top" Width="18" Height="18" ToolTip="Refresh merchant item list" Click="BtnRefreshMerchantItemsList_OnClick">
						<Image Source="images/refresh.png" Stretch="UniformToFill" />
					</Button>
				</Grid>
			</TabItem>
			<TabItem x:Name="tabTargeting" Header="Targeting">
				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition Height="*" />
						<RowDefinition Height="*" />
					</Grid.RowDefinitions>
					<GroupBox x:Name="groupBox_LootList" Header="Loot List" Margin="3">
						<Grid>
							<ListView x:Name="lvLootList">
								<ListView.View>
									<GridView>
										<GridViewColumn Header="Name" DisplayMemberBinding="{Binding Name, Mode=OneTime}" />
										<GridViewColumn Header="Distance" DisplayMemberBinding="{Binding Distance, Mode=OneTime}" />
									</GridView>
								</ListView.View>
							</ListView>
						</Grid>
					</GroupBox>
					<GroupBox x:Name="groupBox_TargetList" Header="Target List" Margin="3" Grid.Row="1">
						<Grid>
							<ListView x:Name="lvTargetsList">
								<ListView.View>
									<GridView>
										<GridViewColumn Header="Name" DisplayMemberBinding="{Binding Name, Mode=OneTime}" />
										<GridViewColumn Header="Distance" DisplayMemberBinding="{Binding Distance, Mode=OneTime}" />
									</GridView>
								</ListView.View>
							</ListView>
						</Grid>
					</GroupBox>
				</Grid>
			</TabItem>
		</TabControl>
	</Grid>
</mah:MetroWindow>
