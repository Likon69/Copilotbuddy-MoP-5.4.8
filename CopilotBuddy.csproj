<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows7.0</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <DefaultItemExcludes>$(DefaultItemExcludes);scratchpad/**</DefaultItemExcludes>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <PlatformTarget>x86</PlatformTarget>
    <Platforms>x86</Platforms>
    <RootNamespace>CopilotBuddy</RootNamespace>
    <AssemblyName>CopilotBuddy</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>CopilotBuddy.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MahApps.Metro" Version="2.4.11" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="System.CodeDom" Version="9.0.0" />
    <PackageReference Include="System.Data.SQLite.Core" Version="1.0.119" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="CopilotBuddy.ico" />
    <Resource Include="images\HbWasp.ico" />
    <Resource Include="images\bender.ico" />
    <Resource Include="images\refresh.png" />
    <Resource Include="images\Copy.png" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Tripper\Tools\**\*.cs" />
    <Reference Include="Tripper.Tools">
      <HintPath>Lib\Tripper.Tools.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <!-- Tripper.RecastManaged.dll is a mixed-mode C++/CLI assembly (COR flags 0x18, ILONLY=false).
         .NET 10 cannot load mixed-mode assemblies, so referencing it would compile and then throw
         BadImageFormatException at runtime. Recast/Detour is reached through Navigation.dll instead. -->
  </ItemGroup>

  <ItemGroup>
    <None Include="Lib\FASM.DLL" Link="FASM.DLL" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Lib\Data.bin" Link="Data.bin" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Lib\Navigation.dll" Link="Navigation.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Bots\ArchaeologyBuddy\Resources\ArchaeologyResources.resx">
      <LogicalName>ArchaeologyBuddy.Resources.ArchaeologyResources.resources</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Update="Bots\ArchaeologyBuddy\Properties\Resources.resx">
      <LogicalName>ArchaeologyBuddy.Properties.Resources.resources</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Update="CommonBehaviors\Resources\CommonBehaviorsResources.resx">
      <LogicalName>CommonBehaviors.Resources.CommonBehaviorsResources.resources</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Update="Styx\Resources\StyxResources.resx">
      <LogicalName>Styx.Resources.StyxResources.resources</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Update="Styx\Localization\Globalization.resx">
      <LogicalName>Styx.Localization.Globalization.resources</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Update="Levelbot\Resources\LevelbotResources.resx">
      <LogicalName>Levelbot.Resources.LevelbotResources.resources</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Update="Bots\Quest\Resources\QuestBotResources.resx">
      <LogicalName>Bots.Quest.Resources.QuestBotResources.resources</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Update="Bots\BGBuddy\Resources\BGBuddyResources.resx">
      <LogicalName>Bots.BGBuddy.Resources.BGBuddyResources.resources</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Update="Bots\Professionbuddy\Localization\Strings.resx">
      <LogicalName>Bots.Professionbuddy.Localization.Strings.resources</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Update="Bots\Professionbuddy\Properties\Resources.resx">
      <LogicalName>Bots.Professionbuddy.Properties.Resources.resources</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Update="Bots\Gatherbuddy\Resources\GatherBuddyResources.resx">
      <LogicalName>Bots.GatherBuddy.Resources.GatherBuddyResources.resources</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Bots\Professionbuddy\Help.rtf">
      <LogicalName>Bots.Professionbuddy.Help.rtf</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Update="NewMixedMode\Resources\NewMixedModeResources.resx">
      <LogicalName>NewMixedMode.Resources.NewMixedModeResources.resources</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Update="PartyBot\Resources\PartyBotResources.resx">
      <LogicalName>PartyBot.Resources.PartyBotResources.resources</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
