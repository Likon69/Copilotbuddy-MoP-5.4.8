<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows7.0</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <DefaultItemExcludes>$(DefaultItemExcludes);scratchpad/**</DefaultItemExcludes>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <PlatformTarget>x86</PlatformTarget>
    <Platforms>x86</Platforms>
    <RootNamespace>CopilotBuddy</RootNamespace>
    <AssemblyName>CopilotBuddy</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>CopilotBuddy.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MahApps.Metro" Version="2.4.11" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="System.CodeDom" Version="9.0.0" />
    <PackageReference Include="System.Data.SQLite.Core" Version="1.0.119" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="CopilotBuddy.ico" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Tripper\Tools\**\*.cs" />
    <Reference Include="Tripper.Tools">
      <HintPath>Lib\Tripper.Tools.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <!-- Tripper.RecastManaged.dll is a mixed-mode C++/CLI assembly (COR flags 0x18, ILONLY=false).
         .NET 10 cannot load mixed-mode assemblies, so referencing it would compile and then throw
         BadImageFormatException at runtime. Recast/Detour is reached through Navigation.dll instead. -->
  </ItemGroup>

  <ItemGroup>
    <None Include="Lib\FASM.DLL" Link="FASM.DLL" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Lib\Navigation.dll" Link="Navigation.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Styx\Resources\StyxResources.resx">
      <LogicalName>Styx.Resources.StyxResources.resources</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Update="Styx\Localization\Globalization.resx">
      <LogicalName>Styx.Localization.Globalization.resources</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
