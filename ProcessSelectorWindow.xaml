<mah:MetroWindow
	x:Class="CopilotBuddy.ProcessSelectorWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls" xmlns:honorbuddy="clr-namespace:CopilotBuddy"
	x:Name="Window"
	Title="Select a WoW"
	Width="280"
	Height="123"
	Background="{DynamicResource WindowBackgroundBrush}"
	GlowBrush="{DynamicResource MahApps.Brushes.Accent}"
	TitleCharacterCasing="Normal"
	ResizeMode="NoResize"
	WindowStartupLocation="CenterOwner"
	Icon="pack://application:,,,/CopilotBuddy.ico">
	<Grid
		x:Name="LayoutRoot">
		<ComboBox
			x:Name="cbProcesses"
			Margin="8,27.96,0,0"
			VerticalAlignment="Top"
			HorizontalAlignment="Left"
			Width="248.693" />
		<TextBlock
			x:Name="textBlock"
			HorizontalAlignment="Left"
			Margin="8,8,0,0"
			TextWrapping="Wrap"
			VerticalAlignment="Top"
			Foreground="#FFFFFFFF"
			Text="Please select a WoW to attach to..." />
		<Button
			x:Name="btnSelect"
			HorizontalAlignment="Left"
			Margin="8,53.92,0,0"
			VerticalAlignment="Top"
			Width="75"
			Content="Select"
			Click="btnSelect_Click" />
		<Button
			x:Name="btnCancel"
			Margin="87,53.92,118,0"
			VerticalAlignment="Top"
			IsCancel="True"
			Content="Cancel"
			Click="btnCancel_Click" />
		<Button
			x:Name="btnRefresh"
			HorizontalAlignment="Right"
			Margin="0,0,8,13.12"
			VerticalAlignment="Bottom"
			Width="75"
			Content="Refresh"
			Click="btnRefresh_Click" />
	</Grid>
</mah:MetroWindow>
