<mah:MetroWindow
	x:Class="CopilotBuddy.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
	mc:Ignorable="d"
	x:Name="Window"
	Title="CopilotBuddy"
	Width="531"
	Height="350"
	Background="{DynamicResource WindowBackgroundBrush}"
	GlowBrush="{DynamicResource MahApps.Brushes.Accent}"
	TitleCharacterCasing="Normal"
	MinWidth="350"
	MinHeight="229"
	Uid="MainWindow"
	Icon="pack://application:,,,/CopilotBuddy.ico">
	<Grid
		x:Name="LayoutRoot">
		<ScrollViewer
			x:Name="scrollLog"
			Margin="8"
			VerticalScrollBarVisibility="Auto">
			<RichTextBox
				x:Name="rtbLog"
				Margin="0"
				IsReadOnly="True"
				UndoLimit="0"
				IsUndoEnabled="False"
				BorderBrush="{x:Null}">
				<FrameworkElement.Resources>
					<ResourceDictionary>
						<Style
							x:Key="{x:Type Paragraph}"
							TargetType="{x:Type Paragraph}">
							<Setter
								Property="Block.Margin"
								Value="0" />
						</Style>
					</ResourceDictionary>
				</FrameworkElement.Resources>
			</RichTextBox>
		</ScrollViewer>
	</Grid>
</mah:MetroWindow>
