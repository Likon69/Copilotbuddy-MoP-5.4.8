<mah:MetroWindow x:Class="CopilotBuddy.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CopilotBuddy"
        mc:Ignorable="d"
        x:Name="Window"
        Title="CopilotBuddy"
        Icon="pack://application:,,,/CopilotBuddy.ico"
        Width="531"
        Height="350"
        MinWidth="350"
        MinHeight="229"
        WindowStartupLocation="CenterScreen"
        TitleCharacterCasing="Normal"
        Background="{DynamicResource WindowBackgroundBrush}"
        GlowBrush="{DynamicResource MahApps.Brushes.Accent}"
        Closing="Window_Closing"
        StateChanged="Window_StateChanged">
    <Grid x:Name="LayoutRoot">
        <Grid.Resources>
            <local:UIHelpers x:Key="uiHelpers"/>
        </Grid.Resources>

        <!-- Bot Selector ComboBox -->
        <ComboBox x:Name="cmbBotSelector"
                  IsEditable="False"
                  HorizontalAlignment="Right"
                  Margin="0,8,8,0"
                  VerticalAlignment="Top"
                  Width="120"
                  SelectionChanged="cmbBotSelector_SelectionChanged"/>

        <!-- Load Profile Button (HB 5.4.8 LoadProfileFromFileSystem - the only profile source this
             project has infrastructure for; HB's Buddy Store / web-profile sources need
             Buddy.Store.Wpf / WebProfileWindow, neither of which exist here) -->
        <Button x:Name="btnLoadProfile"
                HorizontalAlignment="Right"
                Margin="0,35,8,0"
                VerticalAlignment="Top"
                Height="25"
                Width="120"
                Click="btnLoadProfile_Click">
            <Viewbox Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock x:Name="tbLoadProfileText"/>
            </Viewbox>
        </Button>

        <!-- Settings Button -->
        <Button x:Name="btnSettings"
                Height="25"
                HorizontalAlignment="Right"
                Margin="0,62,8,0"
                VerticalAlignment="Top"
                Width="120"
                Click="btnSettings_Click">
            <Viewbox Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock x:Name="tbSettingsText"/>
            </Viewbox>
        </Button>

        <!-- Enhanced Mode Checkbox -->
        <CheckBox x:Name="EnhancedMode"
                  HorizontalAlignment="Right"
                  Margin="0,101,8,0"
                  VerticalAlignment="Top"
                  Width="120"
                  ToolTip="Makes all buttons visible in the main window"
                  Unchecked="EnhancedMode_Unchecked"
                  Checked="EnhancedMode_Checked">
            <Viewbox Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock x:Name="tbEnhancedModeText"/>
            </Viewbox>
        </CheckBox>

        <!-- Bot Config Button (hidden by default) -->
        <Button x:Name="btnBotConfig"
                Visibility="Hidden"
                Margin="0,126,8,0"
                VerticalAlignment="Top"
                Height="19"
                HorizontalAlignment="Right"
                Width="120"
                Click="btnBotConfig_Click">
            <Viewbox Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock x:Name="tbBotConfigText"/>
            </Viewbox>
        </Button>

        <!-- Class Config Button (hidden by default) -->
        <Button x:Name="btnClassConfig"
                Visibility="Hidden"
                Margin="0,151,8,0"
                VerticalAlignment="Top"
                Height="19"
                HorizontalAlignment="Right"
                Width="120"
                Click="btnClassConfig_Click">
            <Viewbox Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock x:Name="tbClassConfigText"/>
            </Viewbox>
        </Button>

        <!-- Plugins Button (hidden by default) -->
        <Button x:Name="btnPlugins"
                Visibility="Hidden"
                Margin="0,176,8,0"
                VerticalAlignment="Top"
                Height="19"
                HorizontalAlignment="Right"
                Width="120"
                Click="btnPlugins_Click">
            <Viewbox Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock x:Name="tbPluginsText"/>
            </Viewbox>
        </Button>

        <!-- Dev Tools Button (hidden by default; no DeveloperToolsWindow exists in this project,
             see MainWindow.xaml.cs btnDevTools_Click) -->
        <Button x:Name="btnDevTools"
                Height="19"
                Visibility="Hidden"
                Margin="0,201,8,0"
                VerticalAlignment="Top"
                HorizontalAlignment="Right"
                Width="120"
                Click="btnDevTools_Click">
            <Viewbox Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock x:Name="tbDevToolsText"/>
            </Viewbox>
        </Button>

        <!-- Start Button -->
        <Button x:Name="btnStart"
                HorizontalAlignment="Right"
                Margin="0,0,8,26"
                VerticalAlignment="Bottom"
                Width="120"
                Height="25"
                Click="btnStart_Click">
            <Viewbox Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,2,0,2">
                <TextBlock x:Name="tbStartText"/>
            </Viewbox>
        </Button>

        <!-- Stop/Pause group (hidden by default, shown while the bot runs).
             HB 5.4.8 uses a db:SplitButton (Styx.Common.WpfControls) for this; that control isn't
             ported into this project, so it is reproduced with a plain Button + a small dropdown
             arrow Button that opens the Pause context menu - same two actions, same behaviour. -->
        <Grid x:Name="btnStopGroup"
              Visibility="Hidden"
              HorizontalAlignment="Right"
              Margin="0,0,8,26"
              VerticalAlignment="Bottom"
              Width="120"
              Height="25">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="17"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="btnStop"
                    Grid.Column="0"
                    Click="btnStop_OnClick">
                <Viewbox Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10,2,0,2">
                    <TextBlock x:Name="tbStopText"/>
                </Viewbox>
            </Button>
            <Button x:Name="btnStopArrow"
                    Grid.Column="1"
                    Padding="0"
                    ToolTip="Pause / Resume"
                    Click="btnStopArrow_Click">
                <Button.ContextMenu>
                    <ContextMenu>
                        <MenuItem x:Name="btnPause" Click="btnPause_OnClick"/>
                    </ContextMenu>
                </Button.ContextMenu>
                <TextBlock Text="&#x25BC;" FontSize="9" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Button>
        </Grid>

        <!-- Tab Control (Log and Info tabs) -->
        <TabControl x:Name="tabControl"
                    Margin="8,8,132,25.96"
                    TabStripPlacement="Bottom">
            <TabItem x:Name="tabLog">
                <Grid>
                    <ScrollViewer x:Name="scrollLog" VerticalScrollBarVisibility="Auto">
                        <RichTextBox x:Name="rtbLog"
                                     Margin="0"
                                     IsReadOnly="True"
                                     UndoLimit="0"
                                     IsUndoEnabled="False"
                                     BorderBrush="{x:Null}">
                            <RichTextBox.Resources>
                                <Style TargetType="{x:Type Paragraph}">
                                    <Setter Property="Margin" Value="0"/>
                                </Style>
                            </RichTextBox.Resources>
                        </RichTextBox>
                    </ScrollViewer>
                </Grid>
            </TabItem>
            <TabItem x:Name="tabInfo">
                <Grid>
                    <ScrollViewer x:Name="scrollInfo" VerticalScrollBarVisibility="Auto">
                        <TextBox x:Name="tbInfoBlock"
                                 Margin="5,5,5,5"
                                 BorderThickness="0"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 Background="#00FFFFFF"
                                 Foreground="{DynamicResource {x:Static SystemColors.ControlLightLightBrushKey}}"/>
                    </ScrollViewer>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Status Bar - bound to UIHelpers.Instance.StatusText, which is fed by
             TreeRoot.OnStatusTextChanged (see UIHelpers.cs), exactly like HB 5.4.8. -->
        <StatusBar Margin="0"
                   VerticalAlignment="Bottom"
                   Background="{DynamicResource WindowBackgroundBrush}"
                   Panel.ZIndex="1">
            <StatusBarItem x:Name="lblActivityText"
                           Foreground="#FFFFFFFF"
                           Content="{Binding Instance.StatusText, Mode=OneWay, Source={StaticResource uiHelpers}}"/>
        </StatusBar>
    </Grid>
</mah:MetroWindow>
